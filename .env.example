# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=lin_api_xxx

# Repos to show your open PRs from (owner/name, comma-separated). Empty = all your open PRs
GITHUB_REPOS=your-org/backend,your-org/frontend

# Where those repos are cloned, by name (e.g. ~/code/backend). Sessions open there.
CODE_DIR=~/code

# Repo a ticket's "New session" opens in (defaults to the first in GITHUB_REPOS)
DEFAULT_REPO=backend

PORT=7777
